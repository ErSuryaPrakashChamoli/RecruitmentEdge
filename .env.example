APP_NAME="Recruitment Edge"
APP_COMPANY_NAME="MarkEdge Technologies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Phase 8.9: one file per day; LOG_DAILY_DAYS=0 keeps every file until the log-retention decision
# (R-13) sets a period. LOG_LEVEL defaults to info in production and debug elsewhere.
LOG_STACK=daily
LOG_DAILY_DAYS=0
LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Phase 8.7 (D8.7-020): must exceed the longest worker --timeout (300 in docker-compose.yml), or a
# job still running is handed to a second worker.
DB_QUEUE_RETRY_AFTER=330
# Longest worker --timeout, checked against DB_QUEUE_RETRY_AFTER by queue:health-check.
QUEUE_WORKER_MAX_TIMEOUT=300
# Failed jobs (and their redacted exception) are pruned after this many hours (D8.7-012).
QUEUE_FAILED_RETENTION_HOURS=720
# Bearer token for GET /health/queue from external monitoring (leave empty to allow administrators only).
QUEUE_HEALTH_TOKEN=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Recruitment Copilot (see config/ai.php). Leave the selected provider's key blank to run
# with graceful "AI not configured" degradation — the rest of the app is unaffected.
# AI_PROVIDER selects the LLM provider; AI_EMBEDDING_PROVIDER / AI_WEB_SEARCH_PROVIDER can each
# independently name a different provider. Only the credential for the provider(s) you actually
# select needs to be set.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
AI_MODEL_CLASSIFICATION=gemini-3.5-flash-lite
AI_MODEL_EXTRACTION=gemini-3.5-flash-lite
AI_MODEL_SUMMARIZATION=gemini-3.6-flash
AI_MODEL_GENERATION=gemini-3.6-flash
AI_MODEL_BALANCED=gemini-3.6-flash
AI_MODEL_ADVANCED=gemini-3.1-pro-preview
AI_MODEL_PLANNING=gemini-3.1-pro-preview
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=50
AI_WEB_SEARCH_PROVIDER=gemini
AI_WEB_SEARCH_ENABLED=false
AI_RAG_ENABLED=true
AI_ACTIONS_ENABLED=true
AI_MAX_TOOL_CALLS=8
AI_MAX_TOKENS=4000
AI_RATE_LIMIT_PER_MINUTE=20
AI_ACTION_RATE_LIMIT_PER_MINUTE=10
AI_MAX_BULK_ACTION_SIZE=50

# Phase 5 — communication, calendar, video and job-board providers (leave blank until configured)
COMMUNICATIONS_QUEUE=communications
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT=common
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
