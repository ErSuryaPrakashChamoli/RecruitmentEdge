APP_NAME="Recruitment Edge"
APP_COMPANY_NAME="MarkEdge Technologies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Phase 8.10 (P810-SEC-001): outside local, every generated and emailed link uses APP_URL's host.
# Optional: the exact host names served, comma separated (include localhost for the health check).
# APP_TRUSTED_HOSTS=
# SaaS-7: the load balancer / TLS proxy whose X-Forwarded-* headers are believed: * or a comma list.
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# SaaS-7: in docker compose the maintenance flag is kept in the shared cache (cache + database),
# so a container recreated during a release stays down until `php artisan up`.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Phase 8.9: one file per day; LOG_DAILY_DAYS=0 keeps every file until the log-retention decision
# (R-13) sets a period. LOG_LEVEL defaults to info in production and debug elsewhere.
LOG_STACK=daily
LOG_DAILY_DAYS=0
LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Phase 8.7 (D8.7-020): must exceed the longest worker --timeout (300 in docker-compose.yml), or a
# job still running is handed to a second worker.
DB_QUEUE_RETRY_AFTER=330
# Longest worker --timeout, checked against DB_QUEUE_RETRY_AFTER by queue:health-check.
QUEUE_WORKER_MAX_TIMEOUT=300
# Failed jobs (and their redacted exception) are pruned after this many hours (D8.7-012).
QUEUE_FAILED_RETENTION_HOURS=720
# Bearer token for GET /health/queue (and the details of GET /health/ready) from external
# monitoring. Empty: those endpoints answer 401 to everyone (the Queue health page still works).
QUEUE_HEALTH_TOKEN=
# SaaS-7 (S7-04): where critical platform events (silent worker or scheduler, failing scheduled task)
# are mailed at once. Unset, they are recorded but reach nobody (ops:preflight warns).
PLATFORM_NOTIFY_EMAIL=
# Phase 8.9: true where workers and the scheduler run (compose, production) — queue health then
# reports a silent worker or a scheduler that never reported.
QUEUE_EXPECT_PROCESSES=false
# Phase 8.9: seconds an hourly intelligence:refresh may spend before deferring the rest to the next run.
INTELLIGENCE_REFRESH_TIME_BUDGET=2700
# Phase 8.9: the most held candidate messages one five-minute reliability sweep re-queues (oldest first).
COMMUNICATIONS_REQUEUE_MAX_PER_RUN=1000
# Phase 8.9: the release tag of the compose image (rollback = previous tag).
APP_IMAGE_TAG=local

CACHE_STORE=database
# SaaS-7: on MySQL, give the database cache store's data its own connection, so cache writes and
# rate-limit counters never join a business transaction; keep its locks on the business connection,
# so a lock commits or rolls back with the work it guards (ops:preflight checks both).
# DB_CACHE_CONNECTION=mysql_cache
# DB_CACHE_LOCK_CONNECTION=mysql
# SaaS-7: queries at least this slow (ms) are logged as db.slow_query (SQL only). 0 = off.
DB_SLOW_QUERY_MS=500
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# SaaS-7: seconds before an unreachable SMTP server gives up (never hangs a worker).
MAIL_TIMEOUT=30
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Recruitment Copilot (see config/ai.php). Leave the selected provider's key blank to run
# with graceful "AI not configured" degradation — the rest of the app is unaffected.
# AI_PROVIDER selects the LLM provider; AI_EMBEDDING_PROVIDER / AI_WEB_SEARCH_PROVIDER can each
# independently name a different provider. Only the credential for the provider(s) you actually
# select needs to be set.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
AI_MODEL_CLASSIFICATION=gemini-3.5-flash-lite
AI_MODEL_EXTRACTION=gemini-3.5-flash-lite
AI_MODEL_SUMMARIZATION=gemini-3.6-flash
AI_MODEL_GENERATION=gemini-3.6-flash
AI_MODEL_BALANCED=gemini-3.6-flash
AI_MODEL_ADVANCED=gemini-3.1-pro-preview
AI_MODEL_PLANNING=gemini-3.1-pro-preview
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=50
AI_WEB_SEARCH_PROVIDER=gemini
AI_WEB_SEARCH_ENABLED=false
AI_RAG_ENABLED=true
AI_ACTIONS_ENABLED=true
AI_MAX_TOOL_CALLS=8
AI_MAX_TOKENS=4000
AI_RATE_LIMIT_PER_MINUTE=20
AI_ACTION_RATE_LIMIT_PER_MINUTE=10
AI_MAX_BULK_ACTION_SIZE=50

# Phase 5 — communication, calendar, video and job-board providers (leave blank until configured)
COMMUNICATIONS_QUEUE=communications
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT=common
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# SaaS-7 (C6): per-tenant fairness for integration work (infrastructure protection, not a quota).
WEBHOOK_TENANT_DELIVERIES_PER_MINUTE=120
WEBHOOK_TENANT_INBOUND_PER_MINUTE=120
# SaaS-7 (C13): a production container refuses to start when ops:preflight finds a blocker.
# Emergency override only (record it): PREFLIGHT_ENFORCE=false
