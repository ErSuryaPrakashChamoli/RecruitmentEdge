# Recruitment Edge — DEMO installation (client presentations only).
#
# 1. cp .env.demo.example .env.demo   and fill in APP_KEY (php artisan key:generate --env=demo)
#    and the AI key if the Copilot should answer live.
# 2. Create the empty demo database (never point this file at a real database).
# 3. APP_ENV=demo php artisan demo:setup --force        (wipes + seeds the demo; re-run to reset)
# 4. APP_ENV=demo php artisan serve --port=8003         (then open http://127.0.0.1:8003/admin)

APP_NAME="Recruitment Edge"
APP_COMPANY_NAME="MarkEdge Technologies"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8003

# Turns on demo mode: the demo:setup command, the demo accounts on the login page and the Demo badge.
APP_DEMO=true
DEMO_PASSWORD="Demo@123"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms_demo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Never send real emails from the demo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# AI Recruitment Copilot — leave the key blank to show the "AI not configured" state.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
AI_MODEL_CLASSIFICATION=gemini-3.5-flash-lite
AI_MODEL_EXTRACTION=gemini-3.5-flash-lite
AI_MODEL_SUMMARIZATION=gemini-3.6-flash
AI_MODEL_GENERATION=gemini-3.6-flash
AI_MODEL_BALANCED=gemini-3.6-flash
AI_MODEL_ADVANCED=gemini-3.1-pro-preview
AI_MODEL_PLANNING=gemini-3.1-pro-preview
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536
AI_WEB_SEARCH_ENABLED=false
AI_RAG_ENABLED=true
AI_ACTIONS_ENABLED=true
